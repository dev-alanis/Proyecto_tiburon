{
  "name": "acuario/tiburon-feliz-api",
  "description": "API interna PWA Acuario Tiburón Feliz",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "firebase/php-jwt": "^6.10",
    "vlucas/phpdotenv": "^5.6",
    "ext-pdo": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
      "optimize-autoloader": true,
      "policy": {
          "advisories": {
              "ignore-id": ["PKSA-y2cr-5h3j-g3ys"]
          }
      }
  }
}